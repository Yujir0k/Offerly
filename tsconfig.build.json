{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022"
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "hooks/**/*.ts",
    "lib/**/*.ts",
    "db/**/*.ts",
    "instrumentation.ts",
    "proxy.ts",
    "next.config.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "vendor",
    "qa",
    ".next-dev",
    "examples"
  ]
}
