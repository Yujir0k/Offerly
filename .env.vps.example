# Copy to .env on the VPS. Supply secrets privately; never commit .env.
# URL-encode special characters if using a manual DATABASE_URL.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_ALPHANUMERIC_SECRET
# Independent least-privilege application role; 32–128 URL-safe random characters.
POSTGRES_APP_PASSWORD=REPLACE_WITH_DISTINCT_RANDOM_ALPHANUMERIC_SECRET
APP_URL=https://your-domain.example
COOKIE_SECURE=true
ENABLE_DEMO=false
# Enable only behind the provided loopback-only reverse proxy.
TRUST_PROXY=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Офферли <noreply@your-domain.example>
MAIL_WORKER_ENABLED=true

# Disabled until the organizer supplies a Keycloak client / realm.
FSP_OIDC_ENABLED=false
FSP_OIDC_ISSUER=
FSP_OIDC_CLIENT_ID=
FSP_OIDC_CLIENT_SECRET=
FSP_OIDC_PARTICIPANT_CLAIM=fsp_id

# Do not show fictional catalogue accounts on the public service.
ENABLE_DEMO_DATA=false
