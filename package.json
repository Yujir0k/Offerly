{
  "name": "offerly",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "install:ci": "npm ci",
    "dev": "next dev --webpack -H 127.0.0.1 -p 5174",
    "build": "next build --webpack",
    "start": "next start -H 127.0.0.1 -p 5174",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:migrate": "node scripts/migrate.mjs",
    "test:platform": "node qa/platform-check.mjs",
    "dev:mail": "node scripts/dev-mail.mjs",
    "assessment:build": "node scripts/build-assessment.mjs",
    "test:assessment": "node scripts/test-assessment.mjs",
    "predev": "node scripts/build-assessment.mjs && node scripts/build-resume-worker.mjs",
    "prebuild": "node scripts/build-assessment.mjs && node scripts/build-resume-worker.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "mail:latest": "node scripts/read-local-mail.mjs",
    "dev:fsp": "node scripts/fsp-demo-provider.mjs",
    "dev:with-fsp": "node scripts/dev-with-fsp.mjs",
    "mcp:stdio": "node scripts/mcp-stdio.mjs",
    "test:employer": "node --import tsx --test qa/employer-ranking.test.ts qa/natural-task-brief.test.ts qa/task-recommendations.test.ts qa/matching-updates.test.ts qa/profile-redaction.test.ts",
    "check:types": "tsc -p tsconfig.check.json --noEmit",
    "check:api": "node qa/openapi-check.mjs",
    "test:regression": "node --import ./qa/server-only-loader.mjs --import tsx --test qa/current-access-filters.test.ts qa/invitation-changes.test.ts qa/chat-network.test.ts qa/assessment-timeout.test.ts qa/assessment-free-navigation.test.ts qa/candidate-order.test.ts qa/profile-redaction.test.ts qa/candidate-comparison.test.ts qa/employer-ranking.test.ts qa/natural-task-brief.test.ts qa/task-recommendations.test.ts qa/matching-updates.test.ts",
    "test:expert-demo": "node --import ./qa/server-only-loader.mjs --import tsx --test qa/expert-demo.test.ts",
    "pretest:expert-demo": "node scripts/build-assessment.mjs",
    "test:grade-matrix": "node --import tsx qa/current-grade-matrix.ts",
    "test:mail": "node --import ./qa/server-only-loader.mjs --import tsx --test qa/mail-delivery.test.ts qa/mail-transport.test.ts",
    "test:security": "node scripts/build-resume-worker.mjs && node --import ./qa/server-only-loader.mjs --import tsx --test qa/request-security.test.ts qa/resume-worker.test.ts qa/assessment-capacity.test.ts qa/assessment-pool-memory.test.ts",
    "setup:docker": "node scripts/setup-docker.mjs",
    "precheck:types": "node scripts/build-assessment.mjs",
    "pretest:regression": "node scripts/build-assessment.mjs",
    "pretest:security": "node scripts/build-assessment.mjs",
    "pretest:mail": "node scripts/build-assessment.mjs",
    "pretest:grade-matrix": "node scripts/build-assessment.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@electric-sql/pglite": "^0.5.8",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.31.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.16",
    "openid-client": "^6.8.8",
    "pg": "^8.23.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sharp": "0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "tsx": "^4.23.15",
    "unpdf": "^1.8.1",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "prettier": "^3.9.9",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  },
  "type": "module"
}
