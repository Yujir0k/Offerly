# Local development only. Use npm run setup:local to create .env.local safely.
APP_URL=http://localhost:5174
ENABLE_DEMO=true
COOKIE_SECURE=false
TRUST_PROXY=false
FSP_OIDC_ENABLED=false
# File delivery: no SMTP account or Mailpit installation required.
MAIL_TRANSPORT=file
MAIL_PREVIEW=false
MAIL_FROM=Офферли <noreply@offerly.test>
# Default persistent data: .data/postgres and .data/uploads.
# Leave DATABASE_URL unset for local PGlite.

# Public fictional catalogue, separate from the isolated demo login.
ENABLE_DEMO_DATA=true
# Optional local fixture password; production requires a unique value when fixtures are enabled.
# DEMO_ACCOUNT_PASSWORD=replace-with-unique-strong-password
